# Public HTTPS URL where the Mini App is hosted
VITE_APP_URL=https://your-domain.example
# Bot username without @
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
# Mini App short name from BotFather
VITE_TELEGRAM_APP_SHORT_NAME=app
# Channel deep link for the funnel CTA
VITE_TELEGRAM_CHANNEL_URL=https://t.me/your_channel
# Bot deep link for the funnel CTA
VITE_TELEGRAM_BOT_URL=https://t.me/your_bot
# Optional explicit share link. If empty, the app falls back to https://t.me/<bot>/<appShortName> or VITE_APP_URL
VITE_TELEGRAM_SHARE_URL=https://t.me/your_bot_username?startapp=share
# Default locale for the app shell
VITE_DEFAULT_LOCALE=ru
